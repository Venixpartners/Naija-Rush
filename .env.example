# Naija Rush environment template. Copy to apps/web/.env.local for local work,
# and set the same names in Vercel (Project Settings > Environment Variables).
# Never commit real values.

# Database: Venix Platform Supabase project (ref rjllbjnriawxavkpskkv).
# Use the TRANSACTION POOLER string from Supabase > Connect (port 6543).
# Tables live in the "naijarush" schema.
DATABASE_URL=postgresql://postgres.rjllbjnriawxavkpskkv:[DB_PASSWORD]@[POOLER_HOST]:6543/postgres
DATABASE_POOL_MAX=5

# Public base URL used in challenge links and share cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://naijarush.venixpartners.com

# Secrets: 32+ random characters each. Generate with: openssl rand -base64 48
RUN_TOKEN_SECRET=
IP_HASH_SALT=
# Daily retention job (Vercel Cron sends it as a bearer token).
CRON_SECRET=

# Admin console (/admin). name:password:role entries, comma separated.
# Roles: admin, moderator, finance. Passwords at least 12 characters.
ADMIN_USERS=

# Challenge link lifetime in days.
CHALLENGE_TTL_DAYS=14

# Optional: Snap Kit app ID, only for share metrics in the Snap Kit portal.
NEXT_PUBLIC_SNAP_APP_ID=
# Set to 1 to hide the Snapchat Creative Kit button.
NEXT_PUBLIC_SNAP_KIT_DISABLED=

# Sign in emails. MAIL_PROVIDER=resend in production; "log" prints links locally.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM="Naija Rush <play@venixpartners.com>"

# Paystack. Start with the test key; payments also need the "payments" flag.
PAYSTACK_SECRET_KEY=

# Rewarded ads server side verification secret (no network chosen yet).
ADS_CALLBACK_SECRET=
